"Se registró una nueva reserva:\n"
"\n"
"Cliente: {{client_name}}\n"
"Email: {{client_email}}\n"
"Teléfono: {{client_phone}}\n"
"Servicio: {{service_name}}\n"
"Con: {{staff_name}}\n"
"Fecha: {{date}}\n"
"Hora: {{time}}"
msgstr "A new booking has been registered:\n\nClient: {{client_name}}\nEmail: {{client_email}}\nPhone: {{client_phone}}\nService: {{service_name}}\nWith: {{staff_name}}\nDate: {{date}}\nTime: {{time}}"

#: includes/emails/class-booking-plugin-email-templates.php:51
msgid "Reserva cancelada: {{client_name}}"
msgstr "Booking cancelled: {{client_name}}"

#: includes/emails/class-booking-plugin-email-templates.php:52
msgid ""
"Se canceló una reserva:\n"
"\n"
"Cliente: {{client_name}}\n"
