msgid "Tu reserva en {{business_name}} fue recibida"
msgstr "Your booking at {{business_name}} was received"

#: includes/emails/class-booking-plugin-email-templates.php:24
msgid ""
"Hola {{client_name}},\n"
"\n"
"Tu reserva quedó registrada con estos datos:\n"
"\n"
"Servicio: {{service_name}}\n"
"Con: {{staff_name}}\n"
"Fecha: {{date}}\n"
"Hora: {{time}}\n"
"\n"
"Podés gestionar tu reserva desde este enlace: {{manage_url}}\n"
"\n"
"Gracias por elegir {{business_name}}."
msgstr "Hi {{client_name}},\n\nYour booking has been registered with these details:\n\nService: {{service_name}}\nWith: {{staff_name}}\nDate: {{date}}\nTime: {{time}}\n\nYou can manage your booking from this link: {{manage_url}}\n\nThank you for choosing {{business_name}}."

#: includes/emails/class-booking-plugin-email-templates.php:30
msgid "Recordatorio: tu cita en {{business_name}} es mañana"
msgstr "Reminder: your appointment at {{business_name}} is tomorrow"

#: includes/emails/class-booking-plugin-email-templates.php:31
msgid ""
"Hola {{client_name}},\n"
"\n"
"Te recordamos tu cita:\n"
"\n"
"Servicio: {{service_name}}\n"
"Con: {{staff_name}}\n"
"Fecha: {{date}}\n"
"Hora: {{time}}\n"
"\n"
"Podés gestionar tu reserva desde este enlace: {{manage_url}}\n"
"\n"
"Te esperamos en {{business_name}}."
msgstr "Hi {{client_name}},\n\nThis is a reminder of your appointment:\n\nService: {{service_name}}\nWith: {{staff_name}}\nDate: {{date}}\nTime: {{time}}\n\nYou can manage your booking from this link: {{manage_url}}\n\nWe look forward to seeing you at {{business_name}}."

#: includes/emails/class-booking-plugin-email-templates.php:37
msgid "Tu reserva en {{business_name}} fue cancelada"
msgstr "Your booking at {{business_name}} was cancelled"

#: includes/emails/class-booking-plugin-email-templates.php:38
msgid ""
"Hola {{client_name}},\n"
"\n"
"Tu reserva fue cancelada:\n"
"\n"
"Servicio: {{service_name}}\n"
"Con: {{staff_name}}\n"
"Fecha: {{date}}\n"
"Hora: {{time}}\n"
"\n"
"Si querés reservar nuevamente, podés hacerlo desde: {{manage_url}}\n"
"\n"
"Gracias por tu comprensión."
msgstr "Hi {{client_name}},\n\nYour booking has been cancelled:\n\nService: {{service_name}}\nWith: {{staff_name}}\nDate: {{date}}\nTime: {{time}}\n\nIf you'd like to book again, you can do so here: {{manage_url}}\n\nThank you for your understanding."

#: includes/emails/class-booking-plugin-email-templates.php:44
msgid "Nueva reserva: {{client_name}}"
msgstr "New booking: {{client_name}}"

#: includes/emails/class-booking-plugin-email-templates.php:45
